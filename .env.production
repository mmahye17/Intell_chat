# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=chat
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=False

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DEFAULT_TTL_SECONDS=1800
REDIS_RAG_TTL_SECONDS=21600
REDIS_RERANK_TTL_SECONDS=21600

# ===== RAG / ChromaDB =====
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=travel_guides

# ===== 嵌入模型 =====
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_KEY=sk-your-key
EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=10

# ===== Rerank =====
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=3

# ===== 检索 =====
CONVERSION_ROUNDS_SIZE=10
RETRIEVER_TOP_K=5

# ===== LLM =====
LLM_API_KEY=sk-your-key
LLM_MODEL=qwen-plus-2025-07-28
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
